# Database Config
DB_HOST=localhost
DB_USER=ts_user
DB_PASSWORD=ts_password
DB_NAME=ticketing_system
DB_PORT=5432

# Database Connection Pool
DB_MAX_OPEN_CONNS=200
DB_MAX_IDLE_CONNS=50
DB_CONN_MAX_LIFETIME_MINUTES=30

# Backend Config
PORT=8001
JWT_SECRET=dev-jwt-secret-change-in-prod-32chars!!
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Redis Config
REDIS_PORT=6379

# Queue-based ticket application mode (Waiting Room + Redis Stream)
# Keep false for the original synchronous flow. Set true to turn high-concurrency booking into async queue processing.
TICKET_QUEUE_ENABLED=false
TICKET_QUEUE_STREAM=ticket:applications
TICKET_QUEUE_GROUP=ticket-workers
TICKET_QUEUE_WORKERS=8
TICKET_QUEUE_MAX_WAITING=100000
TICKET_QUEUE_RESERVATION_TTL_SECONDS=900
TICKET_QUEUE_STATUS_TTL_SECONDS=3600

# MinIO Storage Config
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=ticketing-attachments
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
